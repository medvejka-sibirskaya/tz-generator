# Скопируй в .env и заполни (в git .env не попадает)
YOOMONEY_RECEIVER=4100xxxxxxxxxxxx   # номер кошелька ЮMoney
APP_URL=http://localhost:5000        # в продакшне: https://tz.medvejka.ru

# LLM-полировка текста ТЗ (исправление ошибок и формулировок).
# Если оставить пустым — генерация работает без ИИ.

# --- Вариант 1: Яндекс Cloud YandexGPT (рекомендую для РФ) ---
# В консоли Яндекс.Облака: AI Studio / Foundation Models → создать API-ключ
LLM_BASE_URL=https://llm.api.cloud.yandex.net/openai/v1
LLM_API_KEY=                         # API-ключ сервисного аккаунта
LLM_MODEL=yandexgpt-lite
LLM_FOLDER_ID=                       # ID каталога (folder) из консоли Яндекс.Облака

# --- Вариант 2: любой другой OpenAI-совместимый (OpenRouter и т.п.) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini
# LLM_FOLDER_ID=                     # не заполнять!

# Telegram-уведомления (тот же бот, что шлёт заявки с medvejka.ru).
# Если оставить пустым — сайт работает без уведомлений.
TG_BOT_TOKEN=                         # токен бота от @BotFather
TG_ADMIN_CHAT_ID=                     # chat_id получателя
TG_NOTIFY_ENABLED=                    # 0 = выключить; пусто = включено при наличии токена
# Ключ подписи cookie (сессия "оплатил ГОСТ"). Сгенерируй: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
